// Filter name wrapper examples
ItemDisplayFilterName[]: My PD2 Filter
ItemDisplayFilterName[]:

// ItemDisplay wrapper examples
ItemDisplay[GROUND DAMAGING_POTIONS CLVL>9]: %NAME%
ItemDisplay[]: %NAME%
ItemDisplay[(MAG OR RARE) AND !ID]: %NAME%

// Comparison operators
ItemDisplay[CLVL>=30 AND SOCK=0 AND QUALITY!=UNI]: %NAME%
ItemDisplay[ILVL<10 OR QUALITY==UNI]: %NAME%

// BETWEEN range operator with integer bounds
ItemDisplay[SOCKETS~1-2]: %NAME%

// Addition between condition values
ItemDisplay[FRES+CRES+LRES+PRES>79]: %NAME%
ItemDisplay[STAT60+STAT62>10]: %NAME%

// Complete Boolean keyword
ItemDisplay[MAG OR RARE]: %NAME%

// "OR" inside another token stays plain
ItemDisplay[ORACLE DAMAGING_POTIONS]: %NAME%

// Boolean constant values
ItemDisplay[TRUE]: %NAME%
ItemDisplay[FALSE]:

// Common character and item levels
ItemDisplay[CLVL>=30 AND ILVL>=85]: %NAME%

// Item details and filter settings
ItemDisplay[SOCKETS=0 OR GEMLEVEL>3 OR FILTLVL>1]: %NAME%

// Gold, runes, and prices
ItemDisplay[GOLD<100 OR RUNE>19 OR PRICE>100000]: %NAME%

// Numbers used as condition values are highlighted
ItemDisplay[CLVL>=30]: %NAME%

// Digits within identifiers stay plain
ItemDisplay[ITEM2 SKILL30 2POTIONS]: %NAME%

// Item names and details in output
ItemDisplay[]: %NAME% [Sockets: %SOCKETS%] [Level: %ILVL%]
ItemDisplay[]: %BASENAME% (requires level %LVLREQ%)

// Character and quantity details in output
ItemDisplay[]: %CRAFTALVL% / %REROLLALVL% / %QTY%

// Prices and item codes
ItemDisplay[]: %CODE% costs %BUYPRICE% and sells for %PRICE%
ItemDisplay[]: Alternate sell price: %SELLPRICE%

// Rune, gem, and socket details
ItemDisplay[]: %RUNENAME% #%RUNENUM% / %GEMTYPE% %GEMLEVEL%
ItemDisplay[]: %SOCKETS% of %MAXSOCKETS% sockets, speed %WPNSPD%

// Base weapon damage
ItemDisplay[]: 1H %BASEMINONEH%-%BASEMAXONEH%, 2H %BASEMINTWOH%-%BASEMAXTWOH%
ItemDisplay[]: Throw %BASEMINTHROW%-%BASEMAXTHROW%, kick %BASEMINKICK%-%BASEMAXKICK%
ItemDisplay[]: Smite %BASEMINSMITE%-%BASEMAXSMITE%, block %BASEBLOCK%

// Requirements and upgraded requirements
ItemDisplay[]: Requires %REQSTR% Str, %REQDEX% Dex, level %REQLVL%
ItemDisplay[]: Upgraded requires %UPSTR% Str, %UPDEX% Dex, level %UPLVL%

// Size and base attributes
ItemDisplay[]: %WIDTH%x%HEIGHT% (area %AREA%), max res %MAXRES%, attributes %ALLATTRIB%

// Standard text colors
ItemDisplay[]: %WHITE%White %GRAY%Gray %BLUE%Blue %YELLOW%Yellow
ItemDisplay[]: %GOLD%Gold %GREEN%Green %DARK_GREEN%Dark green %TAN%Tan
ItemDisplay[]: %BLACK%Black %PURPLE%Purple %RED%Red %ORANGE%Orange

// Custom text colors
ItemDisplay[]: %CORAL%Coral %SAGE%Sage %TEAL%Teal %LIGHT_GRAY%Light gray

// Colors beside item values
ItemDisplay[]: %RED%%NAME%%GRAY% [%SOCKETS%]

// Map icons use a two-digit hex color
ItemDisplay[]: %NAME%%BORDER-00%%MAP-9B%%DOT-62%%PX-84%

// MAP can use the current text color
ItemDisplay[]: %ORANGE%%NAME%%MAP%

// Play a drop sound and set notification text color
ItemDisplay[]: %NAME%%SOUNDID-4714%%NOTIFY-F%
ItemDisplay[]: %NAME%%NOTIFY-DEAD%%TIER-0%

// Notification tiers can range from 0 through 12
ItemDisplay[]: %NAME%%TIER-12%

// Continue checking later rules
ItemDisplay[SOCKETS>0]: %NAME% [%SOCKETS%]%CONTINUE%

// Add new lines without accidental blanks
ItemDisplay[]: Item Level: %ILVL%%NL%Sockets: %SOCKETS%
ItemDisplay[]: First%CL%Second

// Add a space only when needed
ItemDisplay[]: %NAME%%CS%[%ILVL%]

// Item descriptions use braces
ItemDisplay[]: %NAME%{Item Level: %ILVL%%NL%Sockets: %SOCKETS%}
ItemDisplay[]: %NAME%{%DARK_GREEN%$%PRICE%}%CONTINUE%

// Descriptions can still be shown for hidden items
ItemDisplay[]: {%NAME%}

// Literal output stays plain
ItemDisplay[]: Perfect find!

// Alias wrapper examples
Alias[UTILITY_POTIONS]: (yps OR wms OR vps)
Alias[COMMON_POTIONS]: (hp1 OR mp1) // comment after replacement
Alias[]: replacement

// Inline comments remain comments
ItemDisplay[MAG]: %NAME% // keep visible
Alias[VISIBLE_POTIONS]: (hp1 OR mp1) // useful at low levels

// Partial keyword matches stay plain text
NotItemDisplay[MAG]: %NAME%
ItemDisplay-ish[MAG]: %NAME%
NotAlias[UTILITY]: replacement
Alias-like[UTILITY]: replacement
