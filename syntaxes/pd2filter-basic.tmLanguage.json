{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "PD2 Filter (Basic)",
	"scopeName": "source.pd2filter-basic",
	"patterns": [
		{
			"include": "#filter-name-rule"
		},
		{
			"include": "#item-display-rule"
		},
		{
			"include": "#formula-rule"
		},
		{
			"include": "#alias-rule"
		},
		{
			"include": "#line-comment"
		}
	],
	"repository": {
		"filter-name-rule": {
			"name": "meta.rule.filter-name.pd2filter",
			"begin": "^\\s*(ItemDisplayFilterName)(\\[)",
			"beginCaptures": {
				"1": {
					"name": "keyword.control.filter-name.pd2filter"
				},
				"2": {
					"name": "punctuation.section.brackets.pd2filter"
				}
			},
			"end": "(\\])(?=\\s*:)(\\s*)(:)",
			"endCaptures": {
				"1": {
					"name": "punctuation.section.brackets.pd2filter"
				},
				"3": {
					"name": "punctuation.separator.rule.pd2filter"
				}
			},
			"patterns": [
				{
					"include": "#line-comment"
				}
			]
		},
		"item-display-rule": {
			"name": "meta.rule.item-display.pd2filter",
			"begin": "^\\s*(ItemDisplay)(\\[)",
			"beginCaptures": {
				"1": {
					"name": "keyword.control.item-display.pd2filter"
				},
				"2": {
					"name": "punctuation.section.brackets.pd2filter"
				}
			},
			"end": "(\\])(?=\\s*:)(\\s*)(:)(.*)$",
			"endCaptures": {
				"1": {
					"name": "punctuation.section.brackets.pd2filter"
				},
				"3": {
					"name": "punctuation.separator.rule.pd2filter"
				},
				"4": {
					"name": "meta.output.item-display.pd2filter",
					"patterns": [
						{
							"include": "#item-display-output"
						}
					]
				}
			},
			"patterns": [
				{
					"name": "constant.other.formula-reference.pd2filter",
					"match": "(?<![A-Za-z0-9_%])F[oO][rR][mM][uU][lL][aA]_[A-Za-z_]+(?![A-Za-z0-9_%])"
				},
				{
					"name": "support.function.condition-value.pd2filter",
					"match": "\\b(?:ALVL|CLVL|CRAFTALVL|DIFF|FILTLVL|GEMLEVEL|GEMTYPE|GEM|GOLD|ILVL|LVLREQ|MAPID|MAPTIER|PRICE|QLVL|QTY|REROLLALVL|RUNE|SOCKETS)\\b"
				},
				{
					"name": "constant.language.condition-boolean.pd2filter",
					"match": "(?<![A-Za-z0-9_])(?:NMAG|MAG|RARE|UNI|SET|CRAFT|NORM|EXC|ELT|ID|INF|SUP|ETH|RW|GEMMED|JEWELRY|CHARM|QUIVER|MISC|EQ1|EQ2|EQ3|EQ4|EQ5|EQ6|EQ7|HELM|CHEST|SHIELD|GLOVES|BOOTS|BELT|CIRC|ARMOR|WP1|WP2|WP3|WP4|WP5|WP6|WP7|WP8|WP9|WP10|WP11|WP12|WP13|AXE|MACE|SWORD|DAGGER|THROWING|JAV|SPEAR|POLEARM|BOW|XBOW|STAFF|WAND|SCEPTER|WEAPON|1H|2H|CLUB|TMACE|HAMMER|aqv|aqv2|aqv3|cqv|cqv2|cqv3|tsc|isc|tbk|ibk|key|leg|ear|std|cm1|cm2|cm3|cm1p|cm2p|cm3p|jew|rin|amu|gcv|gfv|gsv|gzv|gzvs|gpv|gpvs|gcy|gfy|gsy|gly|glys|gpy|gpys|gcb|gfb|gsb|glb|glbs|gpb|gpbs|gcg|gfg|gsg|glg|glgs|gpg|gpgs|gcr|gfr|gsr|glr|glrs|gpr|gprs|gcw|gfw|gsw|glw|glws|gpw|gpws|skc|skf|sku|skl|skls|skz|skzs|r01|r01s|r02|r02s|r03|r03s|r04|r04s|r05|r05s|r06|r06s|r07|r07s|r08|r08s|r09|r09s|r10|r10s|r11|r11s|r12|r12s|r13|r13s|r14|r14s|r15|r15s|r16|r16s|r17|r17s|r18|r18s|r19|r19s|r20|r20s|r21|r21s|r22|r22s|r23|r23s|r24|r24s|r25|r25s|r26|r26s|r27|r27s|r28|r28s|r29|r29s|r30|r30s|r31|r31s|r32|r32s|r33|r33s|CL1|CL2|CL3|CL4|CL5|CL6|CL7|DRU|BAR|DIN|NEC|SIN|SOR|ZON|CLASS|AMAZON|ASSASSIN|BARBARIAN|DRUID|NECROMANCER|PALADIN|SORCERESS|SHOP|EQUIPPED|MERC|INVENTORY|CUBE|STASH|GROUND|ANYDISCOVERED|ALLDISCOVERED|ANYOWNED|ALLOWNED)(?![A-Za-z0-9_])"
				},
				{
					"name": "keyword.operator.arithmetic.pd2filter",
					"match": "\\+"
				},
				{
					"name": "constant.language.boolean.pd2filter",
					"match": "\\b(?:TRUE|FALSE)\\b"
				},
				{
					"name": "constant.numeric.integer.pd2filter",
					"match": "(?<![A-Za-z0-9_])\\d+(?![A-Za-z0-9_])"
				},
				{
					"name": "keyword.operator.comparison.pd2filter",
					"match": "(?:>=|<=|!=|==|>|<|=|~)"
				},
				{
					"name": "keyword.operator.logical.pd2filter",
					"match": "\\b(?:AND|OR)\\b|!"
				},
				{
					"name": "punctuation.section.parens.pd2filter",
					"match": "[()]"
				},
				{
					"include": "#line-comment"
				}
			]
		},
		"item-display-output": {
			"name": "meta.output.item-display.pd2filter",
			"patterns": [
				{
					"name": "meta.formula.inline.pd2filter",
					"begin": "\\$f\\((?=[^)]*\\))",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.formula.pd2filter"
						}
					},
					"end": "\\)(?![^)]*\\))",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.formula.pd2filter"
						}
					},
					"patterns": [
						{
							"include": "#formula-expression"
						}
					]
				},
				{
					"name": "constant.other.formula-reference.pd2filter",
					"match": "%FORMULA_[A-Z_]+%"
				},
				{
					"name": "meta.description.item-display.pd2filter",
					"begin": "\\{(?=[^}]*\\})",
					"beginCaptures": {
						"0": {
							"name": "punctuation.section.braces.pd2filter"
						}
					},
					"end": "\\}",
					"endCaptures": {
						"0": {
							"name": "punctuation.section.braces.pd2filter"
						}
					},
					"patterns": [
						{
							"include": "#item-display-output"
						}
					]
				},
				{
					"name": "keyword.control.output.pd2filter",
					"match": "%(?:CL|CONTINUE|CS|NL)%"
				},
				{
					"name": "keyword.control.notification.pd2filter",
					"match": "%(?:(?:BORDER|DOT|PX)-[0-9A-Fa-f]{2}|MAP(?:-[0-9A-Fa-f]{2})?|NOTIFY-(?:[0-9A-Fa-f]|DEAD)|SOUNDID-[0-9]+|TIER-(?:[0-9]|1[0-2]))%"
				},
				{
					"name": "constant.language.color.pd2filter",
					"match": "%(?:BLACK|BLUE|CORAL|DARK_GREEN|GOLD|GRAY|GREEN|LIGHT_GRAY|ORANGE|PURPLE|RED|SAGE|TAN|TEAL|WHITE|YELLOW)%"
				},
				{
					"name": "constant.other.value-reference.pd2filter",
					"match": "%(?:ALLATTRIB|ALVL|AREA|BASEBLOCK|BASEMAXKICK|BASEMAXONEH|BASEMAXSMITE|BASEMAXTHROW|BASEMAXTWOH|BASEMINKICK|BASEMINONEH|BASEMINSMITE|BASEMINTHROW|BASEMINTWOH|BASENAME|BUYPRICE|CODE|CRAFTALVL|GEMLEVEL|GEMTYPE|HEIGHT|ILVL|LVLREQ|MAXRES|MAXSOCKETS|NAME|PRICE|QTY|RANGE|REQDEX|REQLVL|REQSTR|REROLLALVL|RUNENAME|RUNENUM|SELLPRICE|SOCKETS|UPDEX|UPLVL|UPSTR|WIDTH|WPNSPD)%"
				},
				{
					"include": "#line-comment"
				}
			]
		},
		"formula-expression": {
			"patterns": [
				{
					"name": "punctuation.definition.formula.pd2filter",
					"match": "[()]"
				},
				{
					"name": "keyword.operator.formula.pd2filter",
					"match": "(?:==|!=|>=|<=|[+*/^!<>-])"
				},
				{
					"name": "constant.numeric.formula.pd2filter",
					"match": "(?<![A-Za-z0-9_])(?:\\d+\\.\\d+|\\.\\d+|\\d+)(?![A-Za-z0-9_])"
				},
				{
					"name": "punctuation.separator.formula.pd2filter",
					"match": ","
				}
			]
		},
		"formula-rule": {
			"name": "meta.rule.formula.pd2filter",
			"begin": "^\\s*(Formula)(\\[)([A-Z_]+)(\\])(?=\\s*:)(\\s*)(:)(.*)$",
			"beginCaptures": {
				"1": {
					"name": "keyword.control.formula.pd2filter"
				},
				"2": {
					"name": "punctuation.section.brackets.pd2filter"
				},
				"3": {
					"name": "entity.name.function.formula.pd2filter"
				},
				"4": {
					"name": "punctuation.section.brackets.pd2filter"
				},
				"6": {
					"name": "punctuation.separator.rule.pd2filter"
				},
				"7": {
					"name": "meta.definition.formula.pd2filter",
					"patterns": [
						{
							"include": "#line-comment"
						},
						{
							"include": "#formula-expression"
						}
					]
				}
			},
			"end": "(?=$)"
		},
		"alias-rule": {
			"name": "meta.rule.alias.pd2filter",
			"begin": "^\\s*(Alias)(\\[)",
			"beginCaptures": {
				"1": {
					"name": "keyword.control.alias.pd2filter"
				},
				"2": {
					"name": "punctuation.section.brackets.pd2filter"
				}
			},
			"end": "(\\])(?=\\s*:)(\\s*)(:)",
			"endCaptures": {
				"1": {
					"name": "punctuation.section.brackets.pd2filter"
				},
				"3": {
					"name": "punctuation.separator.rule.pd2filter"
				}
			},
			"patterns": [
				{
					"include": "#line-comment"
				}
			]
		},
		"line-comment": {
			"name": "comment.line.double-slash.pd2filter",
			"match": "//.*$"
		}
	}
}
